---
import { Image } from "astro:assets";
import type { Locale } from "@i18n/ui";
import { useTranslations } from "@i18n/ui";
import { getSiteSettings } from "@lib/queries";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const settings = await getSiteSettings();

const heroWords = {
  en: ["Web", "developer", "for", "fast,", "SEO-ready", "websites"],
  bg: ["Уеб", "разработчик", "за", "бързи,", "SEO-готови", "сайтове"],
  es: ["Desarrollador", "web", "de", "sitios", "rápidos", "con SEO"],
};

const h1Width = { en: "w-[15em]", bg: "w-[15.5em]", es: "w-[16em]" };
---

<section
  id="hero"
  class="wrapper relative flex min-h-dvh w-full flex-col-reverse justify-between gap-[min(21svw,80px)] pt-27 pb-2 md:pt-5"
>
  <h1
    id="main-page-h1"
    data-fade-animation="transform"
    class:list={[
      "pb-section md:pb-svw max-w-full indent-[2ch] text-[clamp(1.313rem,5.625vw+0.188rem,5.25rem)] leading-[1.125] uppercase",
      h1Width[locale],
    ]}
    style="--fade-index: 1"
  >
    {
      heroWords[locale].map((word, i) => (
        <>
          <span style={`--item-index: ${i + 1}`}>{word}</span>{" "}
        </>
      ))
    }
  </h1>
  <p
    data-fade-animation
    class="indent-text-indent ms-auto w-96 max-w-full leading-tight md:me-102 md:w-87 md:max-w-[calc(100%-var(--spacing)*99)]"
    style="--fade-index: 2"
  >
    {t("hero.subtitle")}
  </p>
</section>

<Image
  src={settings.heroBg.url}
  width={2000}
  height={1600}
  alt=""
  aria-hidden="true"
  class="absolute -z-1 hidden h-[110svh] w-full max-w-500 object-cover sm:block"
  widths={[640, 1280, 1920]}
  sizes="100vw"
  priority
/>
