---
import { Image } from "astro:assets";
import SocialLinksList from "@components/UI/SocialLinksList.astro";
import { inlineHTML, type TextBlock } from "@lib/portableText";

type ImageBlock = {
  _key: string;
  _type: "image";
  asset: { url: string; width: number; height: number };
  alt?: string;
  caption?: string;
};

type ContactsBlock = { _key: string; _type: "contacts" };

type Block = TextBlock | ImageBlock | ContactsBlock;

type Chunk =
  | { kind: "block"; block: TextBlock }
  | { kind: "list"; listItem: "bullet" | "number"; items: TextBlock[] }
  | { kind: "image"; block: ImageBlock }
  | { kind: "contacts" };

interface Props {
  body: Block[];
}

const { body } = Astro.props;

const chunks: Chunk[] = [];
for (const raw of body as Block[]) {
  if (raw._type === "image") {
    chunks.push({ kind: "image", block: raw });
  } else if (raw._type === "contacts") {
    chunks.push({ kind: "contacts" });
  } else if (raw._type === "block" && raw.listItem) {
    const last = chunks.at(-1);
    if (last?.kind === "list" && last.listItem === raw.listItem) {
      last.items.push(raw);
    } else {
      chunks.push({ kind: "list", listItem: raw.listItem, items: [raw] });
    }
  } else if (raw._type === "block") {
    chunks.push({ kind: "block", block: raw });
  }
}
---

{
  chunks.map((chunk) => {
    if (chunk.kind === "image") {
      const { block } = chunk;
      if (!block.asset?.url) return null;
      const width = Math.min(900, block.asset.width);
      const height = Math.round((width * block.asset.height) / block.asset.width);
      return (
        <figure style={`--ratio: ${width / height}`}>
          <Image
            src={block.asset.url}
            alt={block.alt ?? ""}
            width={width}
            height={height}
            loading="lazy"
          />
          {block.caption && <figcaption>{block.caption}</figcaption>}
        </figure>
      );
    }

    if (chunk.kind === "contacts") {
      return (
        <address class="thought-contacts">
          <SocialLinksList umamiEvent="thought-contact-click" />
        </address>
      );
    }

    if (chunk.kind === "list") {
      const Tag = chunk.listItem === "bullet" ? "ul" : "ol";
      return (
        <Tag>
          {chunk.items.map((item) => (
            <li set:html={inlineHTML(item.children, item.markDefs)} />
          ))}
        </Tag>
      );
    }

    const { block } = chunk;
    const html = inlineHTML(block.children, block.markDefs);
    if (block.style === "h2") return <h2 set:html={html} />;
    if (block.style === "h3") return <h3 set:html={html} />;
    if (block.style === "h4") return <h4 set:html={html} />;
    if (block.style === "blockquote") return <blockquote set:html={html} />;
    return <p set:html={html} />;
  })
}
