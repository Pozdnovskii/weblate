---
import SocialLink from "@components/UI/SocialLink.astro";
import { type ContactLink, getContacts } from "@lib/queries";

import ContraLogo from "@social-logos/contra_logo.svg";
import UpworkLogo from "@social-logos/upwork_logo.svg";
import LinkedinLogo from "@social-logos/linkedin_logo.svg";
import TgLogo from "@social-logos/tg_logo.svg";
import EmailLogo from "@social-logos/email_logo.svg";
import GitHubLogo from "@social-logos/github_logo.svg";

const { variant } = Astro.props;
const dataUmamiEvent =
  variant === "vertical" ? "header-address-click" : "contacts-address-click";

const PLATFORMS: Record<ContactLink["platform"], { label: string; Icon: typeof ContraLogo }> = {
  contra: { label: "Contra account", Icon: ContraLogo },
  upwork: { label: "Upwork account", Icon: UpworkLogo },
  github: { label: "GitHub account", Icon: GitHubLogo },
  linkedin: { label: "Linkedin account", Icon: LinkedinLogo },
  telegram: { label: "Telegram account", Icon: TgLogo },
  email: { label: "Email me", Icon: EmailLogo },
};
const links = await getContacts();
---

<ul
  class={`flex ${
    variant === "vertical"
      ? "flex-col items-center py-2.5"
      : "flex-wrap gap-x-1 translate-x-[calc(clamp(45px,2.5em,78px)/-6)]"
  }`}
>
  {
    links.map(({ platform, url }) => (
      <SocialLink
        dataUmamiEvent={dataUmamiEvent}
        href={url}
        ariaLabel={PLATFORMS[platform].label}
        Icon={PLATFORMS[platform].Icon}
      />
    ))
  }
</ul>
