{
  "name": "weblate",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-12",
  "assets": {
    // Only the chat endpoint runs the Worker; pages and files come straight
    // from the assets, never through Astro's handler and its cache headers.
    "run_worker_first": ["/api/*"],
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Secrets, set in the dashboard as type Secret (locally read from .env):
  // ANTHROPIC_API_KEY, SANITY_ORGANIZATION_TOKEN (Context Editor).
  // Astro's sessions binding, unused by the site but always added by the adapter.
  // Pinned to the namespace left from the earlier adapter: without an id, deploy
  // tries to create "weblate-session" again and fails (code 10014).
  "kv_namespaces": [{ "binding": "SESSION", "id": "7b5a2baa741b47cd90f3cb8cf37a47e0" }],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Daily scoring of the chat conversations for Insights (src/worker.ts).
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true },
}
